{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cesanta mDash REST Data Logs API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get stored notification logs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://dash.mongoose-os.com/api/v2/logs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve stored notification logs starting from an offset."
        }
      ]
    }
  ],
  "bundled": true
}